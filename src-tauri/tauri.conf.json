{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/dev/crates/tauri-config-schema/schema.json",
  "productName": "Graphium",
  "version": "0.45.1",
  "identifier": "com.graphium.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/fetch-node.mjs && node scripts/bundle-server.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "Graphium",
        "url": "splash.html",
        "width": 440,
        "height": 300,
        "resizable": false,
        "center": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "Graphium",
        "url": "app/index.html",
        "width": 1200,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' http://127.0.0.1:3001 https: ipc: http://ipc.localhost blob:; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/graphium-server"
    ],
    "resources": [
      "sidecar/server.mjs",
      "sidecar/node*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://kumagallium.github.io/Graphium/updater/latest.json",
        "https://github.com/kumagallium/Graphium/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGMzE1OTYzQTQ2QThFRQpSV1R1cUVZNmxoWHpCbDB0SXhpSlQwdGRETzZXSXJ5QnpKVW8rNi9kNTJRdmVPaUN0dW9tR3VmWgo="
    }
  }
}
