node_modules/
dist/
.DS_Store
*.local
.vite/
.env
storybook-static/

# 自動生成ファイル（vite dev/build 時に生成）
public/release_notes.json
# pdf.js の cmap / 標準フォント（node_modules からコピー、vite.config.ts 参照）
public/pdfjs/
# MathLive のフォント（node_modules からコピー、vite.config.ts 参照）
public/mathlive/
public/tesseract/

# 各 bench スクリプトの一時出力（実行ごとに上書き）
# baseline.json / 名前付き snapshot は別途 track する。
bench/results/adversarial-latest.json
bench/results/migration-latest.json
bench/results/performance-latest.json
bench/latest-baseline.json
bench/adversarial-stdout.log
bench/adversarial-summary.md
bench/migration-stdout.log
bench/migration-summary.md
bench/performance-stdout.log
bench/performance-summary.md
bench/delta.md

# Recording intermediates
docs/screenshots/.video-tmp/
docs/screenshots/*.webm

# AI backend data (models, profiles — user-specific)
# 末尾スラッシュ無しの "/data" も併記: worktree 運用で data をディレクトリではなく
# 親への symlink にするため、"data/" だけだと symlink を取りこぼして commit され得る。
/data
data/

# dev サーバーのポート設定（predev で自動生成）
.dev-port

# Tauri build artifacts
src-tauri/target/

# Sidecar server bundle (generated by scripts/bundle-server.mjs)
src-tauri/sidecar/server.mjs

# Bundled Node.js runtime (downloaded by scripts/fetch-node.mjs, ~50MB)
src-tauri/sidecar/node
src-tauri/sidecar/node.exe

# Tauri sidecar binaries (Node copy renamed per host target triple, ~50MB)
src-tauri/binaries/graphium-server-*

# fetch-node temp dir (cleaned up automatically, but ignore in case)
.tmp-node-fetch/

# Claude Code (private config — managed in parent repo)
CLAUDE.md
.claude/
docs/internal/
storybook-static/

# Tesseract.js が実行時に取得する学習データ（リポジトリには含めない）
*.traineddata

# VitePress (user manual) build cache
manual/.vitepress/cache/
