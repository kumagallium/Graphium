{
  "name": "graphium",
  "private": true,
  "version": "0.108.3",
  "description": "Block-based note editor with PROV-DM provenance tracking — built on BlockNote.js",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kumagallium/Graphium.git"
  },
  "scripts": {
    "predev": "bash scripts/kill-dev.sh && node scripts/fetch-fonts.mjs",
    "dev": "bash -c 'export PORT=$(cat .dev-port 2>/dev/null || echo 3001); echo \"[dev] Server port: $PORT\"; concurrently -n client,server -c blue,green \"vite\" \"PORT=$PORT tsx watch --env-file .env src/server/index.ts\"'",
    "dev:client": "node scripts/fetch-fonts.mjs && vite",
    "dev:server": "tsx watch --env-file .env src/server/index.ts",
    "build": "node scripts/fetch-fonts.mjs && tsc && vite build",
    "preview": "vite preview",
    "manual:dev": "vitepress dev manual --port 5199",
    "manual:build": "vitepress build manual",
    "manual:preview": "vitepress preview manual --port 5199",
    "manual:check": "node scripts/check-manual.mjs",
    "test": "vitest",
    "test:e2e": "node e2e/save-smoke.mjs",
    "test:benchmark": "tsx --env-file .env tests/benchmark/material-science/runner.ts",
    "test:benchmark:fetch": "tsx --env-file .env tests/benchmark/material-science/fetch-dataset.ts",
    "test:benchmark:fetch-notion": "tsx --env-file .env tests/benchmark/material-science/fetch-notion-fixture.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tauri": "tauri",
    "tauri:dev": "node scripts/fetch-node.mjs && node scripts/fetch-fonts.mjs && node scripts/bundle-server.mjs && TAURI_ENV_PLATFORM=darwin tauri dev",
    "tauri:build": "node scripts/fetch-node.mjs && node scripts/fetch-fonts.mjs && tauri build",
    "bundle:server": "node scripts/bundle-server.mjs",
    "bundle:node": "node scripts/fetch-node.mjs",
    "bundle:fonts": "node scripts/fetch-fonts.mjs",
    "bench:run": "tsx bench/runner.ts",
    "bench:report": "tsx bench/report.ts",
    "bench:compare": "tsx bench/compare.ts",
    "bench:adversarial": "tsx bench/adversarial.ts",
    "bench:performance": "tsx bench/performance.ts",
    "test:migration": "tsx bench/migration.ts",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "bundle:mcp": "node scripts/bundle-mcp.mjs",
    "test:e2e:mcp": "tsx e2e/mcp-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.135",
    "@ai-sdk/google": "^3.0.139",
    "@ai-sdk/mcp": "^1.0.99",
    "@ai-sdk/openai": "^3.0.134",
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@ai-sdk/provider": "^3.0.19",
    "@blocknote/code-block": "^0.56.0",
    "@blocknote/core": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@blocknote/shadcn": "^0.56.0",
    "@github/copilot-sdk": "^1.0.9",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@shikijs/core": "^4.5.0",
    "@shikijs/engine-javascript": "^4.5.0",
    "@shikijs/langs-precompiled": "^4.5.0",
    "@shikijs/themes": "^4.5.0",
    "@shikijs/types": "^4.5.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.3.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@tiptap/core": "3.32.0",
    "@xyflow/react": "^12.11.2",
    "ai": "^6.0.317",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.1",
    "cytoscape-edgehandles": "^4.0.1",
    "cytoscape-fcose": "^2.2.0",
    "echarts": "^6.1.0",
    "elkjs": "^0.11.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "jsonrepair": "^3.15.0",
    "katex": ">=0.18.2 <0.18.11",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "mathjs": "^15.2.0",
