    "minisearch": "7.2.0",
    "pdfjs-dist": "5.4.296",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "rtf.js": "3.0.9",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "undici": "7.30.1",
    "utif2": "4.1.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.31.0",
    "@types/cytoscape-edgehandles": "^4.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "concurrently": "^9.2.5",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "shadcn": "^4.23.0",
    "storybook": "^10.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@4": ">=4.3.2 <5",
      "ip-address@10": ">=10.7.4 <11",
      "@xmldom/xmldom@0.8": ">=0.8.15 <0.9",
      "source-map-js@1": ">=1.2.2 <2",
      "postcss-selector-parser@7": ">=7.1.6 <8",
      "zod@4": ">=4.6.7 <5",
      "@babel/core@7": ">=7.29.6 <8",
      "shell-quote@1": ">=1.9.0 <2",
      "ws@8": ">=8.21.0 <9",
      "serialize-javascript@>=5 <8": ">=7.1.3 <8",
      "@vitest/browser@4": ">=4.1.10 <5",
      "@vitest/mocker@4": ">=4.1.12 <5",
      "vue@3": ">=3.5.42 <4",
      "@vue/server-renderer@3": ">=3.5.42 <4",
      "storybook>esbuild": ">=0.28.2 <0.29"
    }
  }
}
