{
  "name": "graphium",
  "private": true,
  "version": "0.23.1",
  "description": "Block-based note editor with PROV-DM provenance tracking — built on BlockNote.js",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kumagallium/Graphium.git"
  },
  "pnpm": {
    "overrides": {
      "prosemirror-view": "1.42.0",
      "prosemirror-model": "1.25.9"
    }
  },
  "scripts": {
    "predev": "bash scripts/kill-dev.sh",
    "dev": "bash -c 'export PORT=$(cat .dev-port 2>/dev/null || echo 3001); echo \"[dev] Server port: $PORT\"; concurrently -n client,server -c blue,green \"vite\" \"PORT=$PORT tsx watch --env-file .env src/server/index.ts\"'",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file .env src/server/index.ts",
    "build": "tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "node e2e/save-smoke.mjs",
    "test:benchmark": "tsx --env-file .env tests/benchmark/material-science/runner.ts",
    "test:benchmark:fetch": "tsx --env-file .env tests/benchmark/material-science/fetch-dataset.ts",
    "test:benchmark:fetch-notion": "tsx --env-file .env tests/benchmark/material-science/fetch-notion-fixture.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tauri": "tauri",
    "tauri:dev": "node scripts/fetch-node.mjs && node scripts/bundle-server.mjs && TAURI_ENV_PLATFORM=darwin tauri dev",
    "tauri:build": "node scripts/fetch-node.mjs && tauri build",
    "bundle:server": "node scripts/bundle-server.mjs",
    "bundle:node": "node scripts/fetch-node.mjs",
    "bench:run": "tsx bench/runner.ts",
    "bench:report": "tsx bench/report.ts",
    "bench:compare": "tsx bench/compare.ts",
    "bench:adversarial": "tsx bench/adversarial.ts",
    "bench:performance": "tsx bench/performance.ts",
    "test:migration": "tsx bench/migration.ts",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs --ignore-known"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.68",
    "@ai-sdk/google": "^3.0.60",
    "@ai-sdk/mcp": "^1.0.35",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@blocknote/code-block": "^0.47.3",
    "@blocknote/core": "^0.47.0",
    "@blocknote/react": "^0.47.0",
    "@blocknote/shadcn": "^0.47.0",
    "@hono/node-server": "^1.19.13",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@shikijs/themes": "^3.23.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.3.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@tiptap/core": "3.20.4",
    "ai": "^6.0.154",
    "ai-sdk-provider-claude-code": "^3.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.33.1",
    "cytoscape-edgehandles": "^4.0.1",
    "cytoscape-fcose": "^2.2.0",
    "elkjs": "^0.11.1",
    "fflate": "^0.8.3",
    "hono": "^4.12.12",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.18.1",
    "linkedom": "^0.18.12",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "mathlive": "^0.110.0",
    "pdfjs-dist": "5.4.296",
    "prosemirror-model": "1.25.9",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "rtf.js": "3.0.9",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "utif2": "4.1.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.2",
    "@storybook/addon-a11y": "^10.3.1",
    "@storybook/addon-docs": "^10.3.1",
    "@storybook/addon-onboarding": "^10.3.1",
    "@storybook/addon-vitest": "^10.3.1",
    "@storybook/react-vite": "^10.3.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/react": "^16.3.2",
    "@types/cytoscape": "^3.31.0",
    "@types/cytoscape-edgehandles": "^4.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser-playwright": "4.1.0",
    "@vitest/coverage-v8": "4.1.0",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^17.4.3",
    "esbuild": "^0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.58.2",
    "storybook": "^10.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.0"
  }
}
